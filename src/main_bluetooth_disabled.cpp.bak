/**
 * Golf Swing Analyzer - ESP32 Firmware with Bluetooth Support
 * 
 * Hardware:
 * - Board: XIAO ESP32S3
 * - Sensor: ICM-20948 9-DOF IMU (GY-ICM20948V2)
 * - Connection: I2C (SDA=GPIO5, SCL=GPIO6)
 * 
 * This version adds Bluetooth Serial alongside USB Serial
 * Data is sent to both USB Serial and Bluetooth Serial simultaneously
 */

#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_ICM20X.h>
#include <Adafruit_ICM20948.h>
#include <Adafruit_Sensor.h>
#include "BluetoothSerial.h"

// Check if Bluetooth is available
#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error Bluetooth is not enabled! Please enable Bluetooth in sdkconfig
#endif

// Create sensor and Bluetooth objects
Adafruit_ICM20948 icm;
BluetoothSerial SerialBT;

// I2C configuration for XIAO ESP32S3
#define SDA_PIN 5
#define SCL_PIN 6
#define LED_PIN 21

// Configuration
#define SERIAL_BAUD 115200
#define BT_DEVICE_NAME "GolfSwingAnalyzer"
#define SAMPLE_RATE_HZ 100

// Madgwick filter variables
float q0 = 1.0f, q1 = 0.0f, q2 = 0.0f, q3 = 0.0f;
float beta = 0.5f;
unsigned long lastUpdate = 0;
int sampleCount = 0;

void blinkLED(int times, int delayMs = 100) {
  for (int i = 0; i < times; i++) {
    digitalWrite(LED_PIN, HIGH);
    delay(delayMs);
    digitalWrite(LED_PIN, LOW);
    delay(delayMs);
  }
}

// Madgwick AHRS algorithm update (6DOF - no magnetometer)
void MadgwickQuaternionUpdate(float ax, float ay, float az, float gx, float gy, float gz, float dt) {
  float recipNorm;
  float s0, s1, s2, s3;
  float qDot1, qDot2, qDot3, qDot4;
  float _2q0, _2q1, _2q2, _2q3, _4q0, _4q1, _4q2, _8q1, _8q2, q0q0, q1q1, q2q2, q3q3;

  // Rate of change of quaternion from gyroscope
  qDot1 = 0.5f * (-q1 * gx - q2 * gy - q3 * gz);
  qDot2 = 0.5f * (q0 * gx + q2 * gz - q3 * gy);
  qDot3 = 0.5f * (q0 * gy - q1 * gz + q3 * gx);
  qDot4 = 0.5f * (q0 * gz + q1 * gy - q2 * gx);

  // Compute feedback only if accelerometer measurement valid
  if (!((ax == 0.0f) && (ay == 0.0f) && (az == 0.0f))) {
    // Normalise accelerometer measurement
    recipNorm = 1.0f / sqrt(ax * ax + ay * ay + az * az);
    ax *= recipNorm;
    ay *= recipNorm;
    az *= recipNorm;

    // Auxiliary variables
    _2q0 = 2.0f * q0;
    _2q1 = 2.0f * q1;
    _2q2 = 2.0f * q2;
    _2q3 = 2.0f * q3;
    _4q0 = 4.0f * q0;
    _4q1 = 4.0f * q1;
    _4q2 = 4.0f * q2;
    _8q1 = 8.0f * q1;
    _8q2 = 8.0f * q2;
    q0q0 = q0 * q0;
    q1q1 = q1 * q1;
    q2q2 = q2 * q2;
    q3q3 = q3 * q3;

    // Gradient descent algorithm corrective step
    s0 = _4q0 * q2q2 + _2q2 * ax + _4q0 * q1q1 - _2q1 * ay;
    s1 = _4q1 * q3q3 - _2q3 * ax + 4.0f * q0q0 * q1 - _2q0 * ay - _4q1 + _8q1 * q1q1 + _8q1 * q2q2 + _4q1 * az;
    s2 = 4.0f * q0q0 * q2 + _2q0 * ax + _4q2 * q3q3 - _2q3 * ay - _4q2 + _8q2 * q1q1 + _8q2 * q2q2 + _4q2 * az;
    s3 = 4.0f * q1q1 * q3 - _2q1 * ax + 4.0f * q2q2 * q3 - _2q2 * ay;
    
    recipNorm = 1.0f / sqrt(s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3);
    s0 *= recipNorm;
    s1 *= recipNorm;
    s2 *= recipNorm;
    s3 *= recipNorm;

    // Apply feedback step
    qDot1 -= beta * s0;
    qDot2 -= beta * s1;
    qDot3 -= beta * s2;
    qDot4 -= beta * s3;
  }

  // Integrate rate of change of quaternion
  q0 += qDot1 * dt;
  q1 += qDot2 * dt;
  q2 += qDot3 * dt;
  q3 += qDot4 * dt;

  // Normalise quaternion
  recipNorm = 1.0f / sqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
  q0 *= recipNorm;
  q1 *= recipNorm;
  q2 *= recipNorm;
  q3 *= recipNorm;
}

void setup() {
  // Initialize LED
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  
  // Initialize USB Serial
  Serial.begin(SERIAL_BAUD);
  delay(2000);
  
  Serial.println("========================================");
  Serial.println("Golf Swing Analyzer - ESP32 Firmware");
  Serial.println("Board: XIAO ESP32S3");
  Serial.println("Sensor: ICM-20948 (Adafruit Library)");
  Serial.println("Mode: USB Serial + Bluetooth");
  Serial.println("========================================");
  
  // Initialize Bluetooth Serial
  if (SerialBT.begin(BT_DEVICE_NAME)) {
    Serial.print("Bluetooth device started: ");
    Serial.println(BT_DEVICE_NAME);
    Serial.println("You can now pair with this device");
    blinkLED(3, 100);
  } else {
    Serial.println("Bluetooth initialization failed!");
  }
  
  // Initialize I2C
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  
  Serial.println("Initializing ICM-20948...");
  
  // Try to initialize sensor
  if (!icm.begin_I2C(0x68, &Wire)) {
    if (!icm.begin_I2C(0x69, &Wire)) {
      Serial.println("========================================");
      Serial.println("ERROR: Failed to find ICM-20948!");
      Serial.println("Check wiring:");
      Serial.println("  SDA → GPIO5 (D4)");
      Serial.println("  SCL → GPIO6 (D5)");
      Serial.println("  VCC → 3.3V");
      Serial.println("  GND → GND");
      Serial.println("========================================");
      while (1) {
        blinkLED(5, 50);
        delay(1000);
      }
    }
  }
  
  Serial.println("ICM-20948 found!");
  
  // Configure sensor ranges
  icm.setAccelRange(ICM20948_ACCEL_RANGE_16_G);
  icm.setGyroRange(ICM20948_GYRO_RANGE_2000_DPS);
  icm.setAccelRateDivisor(10);
  icm.setGyroRateDivisor(10);
  
  Serial.println("========================================");
  Serial.println("READY! Streaming quaternions...");
  Serial.println("Format: Q0:w Q1:x Q2:y Q3:z");
  Serial.println("========================================");
  
  if (SerialBT.hasClient()) {
    SerialBT.println("========================================");
    SerialBT.println("Golf Swing Analyzer Connected");
    SerialBT.println("Format: Q0:w Q1:x Q2:y Q3:z");
    SerialBT.println("========================================");
  }
  
  digitalWrite(LED_PIN, HIGH);
  lastUpdate = millis();
}

void loop() {
  sensors_event_t accel, gyro, mag, temp;
  
  // Read sensor data
  bool success = icm.getEvent(&accel, &gyro, &temp, &mag);
  
  if (!success) {
    delay(10);
    return;
  }
  
  unsigned long now = millis();
  float dt = (now - lastUpdate) / 1000.0f;
  lastUpdate = now;
  
  // Get sensor data
  float ax = accel.acceleration.x;
  float ay = accel.acceleration.y;
  float az = accel.acceleration.z;
  float gx = gyro.gyro.x;
  float gy = gyro.gyro.y;
  float gz = gyro.gyro.z;
  
  // Check for valid data
  if (ax == 0.0f && ay == 0.0f && az == 0.0f && 
      gx == 0.0f && gy == 0.0f && gz == 0.0f) {
    delay(10);
    return;
  }
  
  // Update quaternion
  if (dt > 0.001f && dt < 1.0f) {
    MadgwickQuaternionUpdate(ax, ay, az, gx, gy, gz, dt);
    
    // Format quaternion string
    char buffer[100];
    snprintf(buffer, sizeof(buffer), "Q0:%.4f Q1:%.4f Q2:%.4f Q3:%.4f", q0, q1, q2, q3);
    
    // Send to USB Serial
    Serial.println(buffer);
    
    // Send to Bluetooth Serial if client is connected
    if (SerialBT.hasClient()) {
      SerialBT.println(buffer);
      digitalWrite(LED_PIN, !digitalRead(LED_PIN));  // Blink LED when BT active
    } else {
      digitalWrite(LED_PIN, HIGH);  // Solid LED when BT not connected
    }
  }
  
  delay(15);  // ~66Hz
}
